{
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"paths": {
			"$shared/*": ["./shared/*"]
		},
		"types": ["gimloader", "howler"]
	},
	"include": ["./plugins/**/*.ts", "./shared/**/*.ts", "./main.d.ts"]
}
